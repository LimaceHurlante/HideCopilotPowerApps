{
  "manifest_version": 3,
  "name": "Hide Copilot in PowerApps",
  "version": "1.0",
  "description": "Hide Copilot button div on make.powerapps.com",
  "permissions": ["scripting", "tabs"],
  "content_scripts": [
    {
      "matches": ["https://make.powerapps.com/*"],
      "js": ["removeCopilot.js"],
      "run_at": "document_idle"
    }
  ]
}
